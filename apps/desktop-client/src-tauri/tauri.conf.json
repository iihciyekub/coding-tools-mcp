{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Tools MCP",
  "version": "0.3.0",
  "identifier": "com.codingtoolsmcp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coding Tools MCP",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage Coding Tools MCP workspaces",
    "longDescription": "Start workspace-confined MCP runtimes and authenticated Cloudflare tunnels.",
    "copyright": "Copyright © Coding Tools MCP Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
